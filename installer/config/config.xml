    <Publisher>larsoyd</Publisher>
    <ProductUrl>https://github.com/larsoyd/duke3d-megaton-ultrawide-fix</ProductUrl>
    <TargetDir>@HomeDir@/.local/share/duke3d-megaton-ultrawide-fix</TargetDir>
    <MaintenanceToolName>uninstall-ultrawide-fix</MaintenanceToolName>
